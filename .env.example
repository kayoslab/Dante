# Postgres — used by Next.js (Drizzle) and the TS sync.
# Defaults match docker-compose.yml. Override for non-dev environments.
POSTGRES_USER=dante
POSTGRES_PASSWORD=dante-dev
POSTGRES_DB=dante
POSTGRES_PORT=5432

# Canonical connection string consumed by Drizzle (Node) and psycopg (Python).
DATABASE_URL=postgresql://dante:dante-dev@localhost:5432/dante

# Personio API credentials (existing — read by lib/sync/credentials.ts).
# PERSONIO_CLIENT_ID=
# PERSONIO_CLIENT_SECRET=

# awork API credentials (existing — read by lib/sync/credentials.ts).
# AWORK_CLIENT_ID=
# AWORK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Auth (Auth.js v5)
# -----------------------------------------------------------------------------
# Required for every environment. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Used by Auth.js to derive callback URLs in production. In dev, leave unset.
# AUTH_URL=https://dante.example.com

# DEV MODE — accepts any password, derives role from the lists below.
# NEVER set AUTH_DEV_MODE=true in production. The sign-in form will accept
# `admin@example.com` (or any other email) with no password verification.
AUTH_DEV_MODE=true
AUTH_DEV_ADMIN_EMAILS=admin@example.com
AUTH_DEV_MANAGER_EMAILS=

# PROD MODE — set when AUTH_DEV_MODE is unset/false. Values come from
# `terraform output` after applying terraform/envs/dev (or envs/prod).
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_ISSUER=
# COGNITO_USER_POOL_ID=
# COGNITO_OAUTH_ENDPOINT=
