# --- Secrets + local config -------------------------------------------------
# Never commit secrets. Everything sensitive lives here in dev; in prod
# the same values come from AWS Secrets Manager via the sync-lambda /
# ECS task definitions.
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
.swc/
out/
build/
*.tsbuildinfo
next-env.d.ts

# --- TypeScript build artifacts --------------------------------------------
dist/
*.js.map

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Coverage / test artifacts ---------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/

# --- Terraform -------------------------------------------------------------
# State files contain ARNs, IDs, and (occasionally) secret material —
# never commit. Use S3 + DynamoDB locking for multi-operator setups.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.tfstate.lock.info
*.tfplan
crash.log
crash.*.log
# Lock file IS committed — pins provider versions across the team.
!.terraform.lock.hcl

# --- AWS / cloud tooling ---------------------------------------------------
.aws-sam/
.serverless/

# --- Editors + OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Agent + assistant state ----------------------------------------------
# Claude Code's per-machine settings live here and tend to embed local
# paths / personal preferences. Each developer keeps their own copy.
.claude/

# --- Docker artifacts -----------------------------------------------------
.docker/

# --- Local data + dumps ---------------------------------------------------
data/
*.csv
*.duckdb
*.duckdb.wal

# --- Python (legacy migration leftovers; harmless to keep ignored) --------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Lambda + sync bundles ------------------------------------------------
# Generated by `npm run build:sync-lambda`; output is determined by the
# source tree, so checking it in just adds noise to PRs.
frontend/dist/
